NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/unibazzar

JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE_DAYS=30

# Comma-separated allowed origins for CORS
CLIENT_URL=http://localhost:5173
FRONTEND_URL=https://ecommerce-frontend-six-vert.vercel.app

# Email (for verification/contact flows)
BREVO_API_KEY=replace_with_brevo_api_key

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=demo_cloud_name
CLOUDINARY_API_KEY=demo_cloudinary_api_key
CLOUDINARY_API_SECRET=demo_cloudinary_api_secret

# AI assistant
GEMINI_API_KEY=replace_with_gemini_api_key

# Queue/worker
ENABLE_CHAT_WORKER=false
CHAT_QUEUE_CONCURRENCY=5
REDIS_URL=redis://localhost:6379